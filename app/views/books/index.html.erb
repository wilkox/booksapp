<h1>Listing books</h1>

<table>
  <tr>
    <th>Title</th>
    <th>Author</th>
    <th>Description</th>
    <th>Amazonid</th>
    <th>Bgcol</th>
    <th>Textcol1</th>
    <th>Textcol2</th>
    <th>Font1</th>
    <th>Font2</th>
    <th></th>
    <th></th>
    <th></th>
  </tr>

<% @books.each do |book| %>
  <tr>
    <td><%= book.title %></td>
    <td><%= book.author %></td>
    <td><%= book.description %></td>
    <td><%= book.amazonid %></td>
    <td><%= book.bgcol %></td>
    <td><%= book.textcol1 %></td>
    <td><%= book.textcol2 %></td>
    <td><%= book.font1 %></td>
    <td><%= book.font2 %></td>
    <td><%= link_to 'Show', book %></td>
    <td><%= link_to 'Edit', edit_book_path(book) %></td>
    <td><%= link_to 'Destroy', book, method: :delete, data: { confirm: 'Are you sure?' } %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to 'New Book', new_book_path %>
